<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="auth_secure_prefs.xml" />
        <exclude domain="sharedpref" path="database_passphrase_prefs.xml" />
        <exclude domain="sharedpref" path="auth_keyset.xml" />
        <exclude domain="sharedpref" path="database_passphrase_keyset.xml" />
        <exclude domain="database" path="app_database" />
        <exclude domain="database" path="app_database-shm" />
        <exclude domain="database" path="app_database-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="auth_secure_prefs.xml" />
        <exclude domain="sharedpref" path="database_passphrase_prefs.xml" />
        <exclude domain="sharedpref" path="auth_keyset.xml" />
        <exclude domain="sharedpref" path="database_passphrase_keyset.xml" />
        <exclude domain="database" path="app_database" />
        <exclude domain="database" path="app_database-shm" />
        <exclude domain="database" path="app_database-wal" />
    </device-transfer>
</data-extraction-rules>
